NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/medlog
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=*
OTP_TTL_MINUTES=10
# Verification codes are 4 digits; outside production the first 4 digits of DEFAULT_OTP are used.
DEFAULT_OTP=1234
LOG_LEVEL=info

# Protocol and References PDF storage (relative to the backend folder).
UPLOAD_DIR=uploads

# Public base URL of this API, used for Stripe return links (e.g. https://xxxx-4000.inc1.devtunnels.ms).
# When empty it is derived from the incoming request.
PUBLIC_API_URL=

# Stripe Checkout (subscriptions). Leave empty to disable payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Comma-separated prefixes the app may ask Stripe to return to after checkout.
PAYMENT_RETURN_URL_PREFIXES=medlog://,exp://,http://localhost,https://localhost

# Email for verification and password-reset codes: "smtp", "brevo" or "resend".
# Required when NODE_ENV=production; in development the fixed DEFAULT_OTP is used if left empty.
# When SMTP_USER and SMTP_PASS are set and EMAIL_PROVIDER is empty, SMTP is used.
EMAIL_PROVIDER=
EMAIL_FROM_NAME=MedLog

# SMTP (e.g. Gmail: 2-Step Verification on, then create an App Password). Port 465 = SSL, 587 = STARTTLS.
# Note: free hosts such as Render block outbound SMTP ports; use brevo/resend there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# HTTPS email APIs (brevo or resend). EMAIL_FROM must be a sender verified with the provider.
EMAIL_API_KEY=
EMAIL_FROM=
